# Supabase — copia in .env.local e compila con i tuoi valori
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Solo lato server, mai esporre al client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Email che puo' accedere all'admin (whitelist)
ADMIN_EMAIL=tu@pineslog.com

# Public site URL — usato per redirect del magic link
NEXT_PUBLIC_SITE_URL=https://pineslog.com
